{
  "$schema": "../../../../../schemas/token-file.schema.json",
  "$description": "Platform-neutral typography primitives using resilient system defaults.",
  "typography": {
    "primitive": {
      "font-family": {
        "sans": {
          "$value": ["Inter", "ui-sans-serif", "system-ui", "sans-serif"],
          "$type": "fontFamily",
          "$description": "Primary sans-serif stack with platform fallbacks.",
          "$extensions": {
            "org.interfaceos": { "tier": "primitive", "status": "draft" }
          }
        },
        "mono": {
          "$value": ["ui-monospace", "SFMono-Regular", "Menlo", "monospace"],
          "$type": "fontFamily",
          "$description": "Monospace stack for code and machine identifiers.",
          "$extensions": {
            "org.interfaceos": { "tier": "primitive", "status": "draft" }
          }
        }
      },
      "font-size": {
        "100": {
          "$value": { "value": 12, "unit": "px" },
          "$type": "dimension",
          "$description": "Small supporting text; not the default body size.",
          "$extensions": {
            "org.interfaceos": { "tier": "primitive", "status": "draft" }
          }
        },
        "200": {
          "$value": { "value": 14, "unit": "px" },
          "$type": "dimension",
          "$description": "Compact text step.",
          "$extensions": {
            "org.interfaceos": { "tier": "primitive", "status": "draft" }
          }
        },
        "300": {
          "$value": { "value": 16, "unit": "px" },
          "$type": "dimension",
          "$description": "Default readable body step.",
          "$extensions": {
            "org.interfaceos": { "tier": "primitive", "status": "draft" }
          }
        },
        "400": {
          "$value": { "value": 18, "unit": "px" },
          "$type": "dimension",
          "$description": "Emphasized body step.",
          "$extensions": {
            "org.interfaceos": { "tier": "primitive", "status": "draft" }
          }
        },
        "500": {
          "$value": { "value": 20, "unit": "px" },
          "$type": "dimension",
          "$description": "Small heading step.",
          "$extensions": {
            "org.interfaceos": { "tier": "primitive", "status": "draft" }
          }
        },
        "600": {
          "$value": { "value": 24, "unit": "px" },
          "$type": "dimension",
          "$description": "Section heading step.",
          "$extensions": {
            "org.interfaceos": { "tier": "primitive", "status": "draft" }
          }
        },
        "700": {
          "$value": { "value": 32, "unit": "px" },
          "$type": "dimension",
          "$description": "Page heading step.",
          "$extensions": {
            "org.interfaceos": { "tier": "primitive", "status": "draft" }
          }
        },
        "800": {
          "$value": { "value": 40, "unit": "px" },
          "$type": "dimension",
          "$description": "Display heading step.",
          "$extensions": {
            "org.interfaceos": { "tier": "primitive", "status": "draft" }
          }
        }
      },
      "font-weight": {
        "regular": {
          "$value": 400,
          "$type": "fontWeight",
          "$description": "Default reading weight.",
          "$extensions": {
            "org.interfaceos": { "tier": "primitive", "status": "draft" }
          }
        },
        "medium": {
          "$value": 500,
          "$type": "fontWeight",
          "$description": "Moderate emphasis weight.",
          "$extensions": {
            "org.interfaceos": { "tier": "primitive", "status": "draft" }
          }
        },
        "semibold": {
          "$value": 600,
          "$type": "fontWeight",
          "$description": "Heading and control emphasis weight.",
          "$extensions": {
            "org.interfaceos": { "tier": "primitive", "status": "draft" }
          }
        },
        "bold": {
          "$value": 700,
          "$type": "fontWeight",
          "$description": "Strong emphasis weight.",
          "$extensions": {
            "org.interfaceos": { "tier": "primitive", "status": "draft" }
          }
        }
      },
      "line-height": {
        "tight": {
          "$value": 1.2,
          "$type": "number",
          "$description": "Display line-height ratio.",
          "$extensions": {
            "org.interfaceos": { "tier": "primitive", "status": "draft" }
          }
        },
        "heading": {
          "$value": 1.3,
          "$type": "number",
          "$description": "Heading line-height ratio.",
          "$extensions": {
            "org.interfaceos": { "tier": "primitive", "status": "draft" }
          }
        },
        "body": {
          "$value": 1.5,
          "$type": "number",
          "$description": "Default body line-height ratio supporting readability.",
          "$extensions": {
            "org.interfaceos": { "tier": "primitive", "status": "draft" }
          }
        },
        "relaxed": {
          "$value": 1.65,
          "$type": "number",
          "$description": "Long-form reading line-height ratio.",
          "$extensions": {
            "org.interfaceos": { "tier": "primitive", "status": "draft" }
          }
        }
      },
      "letter-spacing": {
        "tight": {
          "$value": { "value": -0.2, "unit": "px" },
          "$type": "dimension",
          "$description": "Limited tightening for large headings.",
          "$extensions": {
            "org.interfaceos": { "tier": "primitive", "status": "draft" }
          }
        },
        "normal": {
          "$value": { "value": 0, "unit": "px" },
          "$type": "dimension",
          "$description": "Unmodified default tracking.",
          "$extensions": {
            "org.interfaceos": { "tier": "primitive", "status": "draft" }
          }
        },
        "wide": {
          "$value": { "value": 0.4, "unit": "px" },
          "$type": "dimension",
          "$description": "Limited expansion for labels, not body copy.",
          "$extensions": {
            "org.interfaceos": { "tier": "primitive", "status": "draft" }
          }
        }
      }
    }
  }
}
