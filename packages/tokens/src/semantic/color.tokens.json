          "border": {
            "$value": "{color.theme.status.warning.border}",
            "$type": "color",
            "$description": "Warning boundary.",
            "$extensions": {
              "org.interfaceos": { "tier": "semantic", "status": "approved" }
            }
          }
        },
        "danger": {
          "background": {
            "$value": "{color.theme.status.danger.background}",
            "$type": "color",
            "$description": "Danger surface; never the only error cue.",
            "$extensions": {
              "org.interfaceos": { "tier": "semantic", "status": "approved" }
            }
          },
          "foreground": {
            "$value": "{color.theme.status.danger.foreground}",
            "$type": "color",
            "$description": "Danger content.",
            "$extensions": {
              "org.interfaceos": { "tier": "semantic", "status": "approved" }
