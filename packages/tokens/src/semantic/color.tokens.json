{
  "$schema": "../../../../../schemas/token-file.schema.json",
  "$description": "Theme-independent semantic color API. Consumers use these names and never palette or theme names.",
  "color": {
    "semantic": {
      "$type": "color",
      "background": {
        "canvas": {
          "$value": "{color.theme.background.canvas}",
          "$type": "color",
          "$description": "Primary application canvas.",
          "$extensions": {
            "org.interfaceos": { "tier": "semantic", "status": "approved" }
          }
        },
        "surface": {
          "$value": "{color.theme.background.surface}",
          "$type": "color",
          "$description": "Raised or grouped surface.",
          "$extensions": {
            "org.interfaceos": { "tier": "semantic", "status": "approved" }
          }
        },
        "subtle": {
          "$value": "{color.theme.background.subtle}",
          "$type": "color",
          "$description": "Subtle differentiated region.",
          "$extensions": {
            "org.interfaceos": { "tier": "semantic", "status": "approved" }
          }
        },
        "inverse": {
          "$value": "{color.theme.background.inverse}",
          "$type": "color",
          "$description": "High-contrast inverse surface.",
          "$extensions": {
            "org.interfaceos": { "tier": "semantic", "status": "approved" }
          }
        }
      },
      "text": {
        "primary": {
          "$value": "{color.theme.text.primary}",
          "$type": "color",
          "$description": "Default readable text.",
          "$extensions": {
            "org.interfaceos": { "tier": "semantic", "status": "approved" }
          }
        },
        "secondary": {
          "$value": "{color.theme.text.secondary}",
          "$type": "color",
          "$description": "Supporting text with AA contrast target.",
          "$extensions": {
            "org.interfaceos": { "tier": "semantic", "status": "approved" }
          }
        },
        "disabled": {
          "$value": "{color.theme.text.disabled}",
          "$type": "color",
          "$description": "Unavailable content; state must have a non-color cue.",
          "$extensions": {
            "org.interfaceos": { "tier": "semantic", "status": "approved" }
          }
        },
        "inverse": {
          "$value": "{color.theme.text.inverse}",
          "$type": "color",
          "$description": "Text on inverse surfaces.",
          "$extensions": {
            "org.interfaceos": { "tier": "semantic", "status": "approved" }
          }
        }
      },
      "border": {
        "default": {
          "$value": "{color.theme.border.default}",
          "$type": "color",
          "$description": "Default visible boundary.",
          "$extensions": {
            "org.interfaceos": { "tier": "semantic", "status": "approved" }
          }
        },
        "strong": {
          "$value": "{color.theme.border.strong}",
          "$type": "color",
          "$description": "Emphasized visible boundary.",
          "$extensions": {
            "org.interfaceos": { "tier": "semantic", "status": "approved" }
          }
        }
      },
      "focus": {
        "ring": {
          "$value": "{color.theme.focus.ring}",
          "$type": "color",
          "$description": "Keyboard focus indicator requiring 3:1 adjacent contrast.",
          "$extensions": {
            "org.interfaceos": { "tier": "semantic", "status": "approved" }
          }
        }
      },
      "interactive": {
        "primary": {
          "default": {
            "$value": "{color.theme.interactive.primary.default}",
            "$type": "color",
            "$description": "Primary interactive surface.",
            "$extensions": {
              "org.interfaceos": { "tier": "semantic", "status": "approved" }
            }
          },
          "hover": {
            "$value": "{color.theme.interactive.primary.hover}",
            "$type": "color",
            "$description": "Primary interactive hover surface.",
            "$extensions": {
              "org.interfaceos": { "tier": "semantic", "status": "approved" }
            }
          },
          "active": {
            "$value": "{color.theme.interactive.primary.active}",
            "$type": "color",
            "$description": "Primary interactive active surface.",
            "$extensions": {
              "org.interfaceos": { "tier": "semantic", "status": "approved" }
            }
          },
          "foreground": {
            "$value": "{color.theme.interactive.primary.foreground}",
            "$type": "color",
            "$description": "Content on primary interactive surfaces.",
            "$extensions": {
              "org.interfaceos": { "tier": "semantic", "status": "approved" }
            }
          }
        }
      },
      "status": {
        "success": {
          "background": {
            "$value": "{color.theme.status.success.background}",
            "$type": "color",
            "$description": "Success surface; never the only success cue.",
            "$extensions": {
              "org.interfaceos": { "tier": "semantic", "status": "approved" }
