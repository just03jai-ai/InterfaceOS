{
  "name": "interfaceos",
  "version": "0.0.0",
  "private": true,
  "description": "AI-native Design Intelligence Platform",
  "packageManager": "pnpm@11.11.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "pnpm tokens:build && pnpm typecheck && pnpm validate",
    "format": "prettier --check .",
    "format:write": "prettier --write .",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "node --test tests/**/*.test.mjs",
    "tokens:build": "node packages/tokens/scripts/build.mjs",
    "tokens:validate": "node packages/tokens/scripts/validate.mjs",
    "validate": "pnpm validate:schemas && pnpm tokens:validate && pnpm validate:links && pnpm validate:secrets",
    "validate:links": "node scripts/validate-doc-links.mjs",
    "validate:schemas": "node scripts/validate-schemas.mjs",
    "validate:secrets": "node scripts/check-secrets.mjs",
    "quality": "pnpm format && pnpm lint && pnpm typecheck && pnpm test && pnpm validate"
  },
  "devDependencies": {
    "@eslint/js": "^9.32.0",
    "@types/node": "^24.1.0",
    "ajv": "^8.17.1",
    "ajv-formats": "^3.0.1",
    "eslint": "^9.32.0",
    "globals": "^16.3.0",
    "prettier": "^3.6.2",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.38.0"
  }
}
