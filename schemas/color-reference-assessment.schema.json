{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://interfaceos.dev/schemas/color-reference-assessment.schema.json",
  "title": "InterfaceOS External Color Reference Assessment",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "$schema",
    "schemaVersion",
    "id",
    "source",
    "policy",
    "semanticPatterns",
    "baseFamilyCandidates",
    "scaleObservation"
  ],
  "properties": {
    "$schema": { "type": "string", "format": "uri-reference" },
    "schemaVersion": { "const": "1.0.0" },
    "id": { "const": "IOS-FND-COLOR-REF-FRAMEPAD" },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "url", "assessedDate"],
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "url": { "const": "https://www.framepad.co/preview/foundations/color" },
        "assessedDate": { "type": "string", "format": "date" }
      }
    },
    "policy": {
      "const": "architecture-and-requirement-coverage-only-no-values-assets-or-token-names-adopted"
    },
    "semanticPatterns": {
      "type": "array",
      "minItems": 9,
      "maxItems": 9,
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/semanticPattern" }
    },
    "baseFamilyCandidates": {
      "type": "array",
      "minItems": 21,
      "maxItems": 21,
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/baseFamilyCandidate" }
    },
    "scaleObservation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["observedStops", "disposition", "interfaceOSRequirement"],
      "properties": {
        "observedStops": {
          "type": "array",
          "prefixItems": [
            { "const": "50" },
            { "const": "100" },
            { "const": "200" },
            { "const": "300" },
            { "const": "400" },
            { "const": "500" },
            { "const": "600" },
            { "const": "700" },
            { "const": "800" },
            { "const": "900" },
            { "const": "950" }
          ],
          "minItems": 11,
          "maxItems": 11
        },
        "disposition": { "const": "architecture-already-covered" },
        "interfaceOSRequirement": { "type": "string", "minLength": 1 }
      }
    }
  },
  "$defs": {
    "semanticPattern": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "observedResponsibilities",
        "disposition",
        "interfaceOSRequirement"
      ],
      "properties": {
        "name": {
          "enum": [
            "neutral",
            "primary-brand",
            "secondary",
            "tertiary",
            "success",
            "warning",
            "danger",
            "text",
            "alpha"
          ]
        },
        "observedResponsibilities": {
          "type": "array",
          "minItems": 4,
          "uniqueItems": true,
          "items": { "type": "string", "pattern": "^[a-z]+(?:-[a-z]+)*$" }
        },
        "disposition": { "enum": ["adapted", "deferred"] },
        "interfaceOSRequirement": { "type": "string", "minLength": 1 }
      }
    },
    "baseFamilyCandidate": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "disposition", "rationale"],
      "properties": {
        "name": { "type": "string", "pattern": "^[a-z]+$" },
        "disposition": {
          "enum": [
            "existing-candidate",
            "evaluation-only",
            "rejected-as-primitive-name"
          ]
        },
        "rationale": { "type": "string", "minLength": 1 }
      }
    }
  }
}
