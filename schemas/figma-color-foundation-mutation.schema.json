{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://interfaceos.dev/schemas/figma-color-foundation-mutation.schema.json",
  "title": "InterfaceOS Figma Color Foundation Mutation Record",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "$schema",
    "schemaVersion",
    "id",
    "milestone",
    "status",
    "mutationTimestamp",
    "operator",
    "sourceRevision",
    "file",
    "page",
    "section",
    "boards",
    "collections",
    "figmaRevision",
    "screenshots",
    "verification",
    "differences",
    "approvals"
  ],
  "properties": {
    "$schema": { "type": "string", "format": "uri-reference" },
    "schemaVersion": { "const": "1.0.0" },
    "id": { "const": "IOS-003.1-FIGMA-COLOR-MUTATION" },
    "milestone": { "const": "IOS-003.1" },
    "status": { "const": "implemented-pending-human-review" },
    "mutationTimestamp": { "type": "string", "format": "date-time" },
    "operator": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "mechanism", "authenticated"],
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "mechanism": { "const": "Figma Plugin API integration" },
        "authenticated": { "const": true }
      }
    },
    "sourceRevision": {
      "type": "object",
      "additionalProperties": false,
      "required": ["gitCommit", "worktreeState"],
      "properties": {
        "gitCommit": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
        "worktreeState": { "const": "dirty-uncommitted" }
      }
    },
    "file": {
      "type": "object",
      "additionalProperties": false,
      "required": ["key", "name"],
      "properties": {
        "key": { "const": "OJqxFKoGjRh4rrSZCKdkzi" },
        "name": { "const": "InterfaceOS — Design System" }
      }
    },
    "page": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "name"],
      "properties": {
        "id": { "const": "2:4" },
        "name": { "const": "03 Foundations" }
      }
    },
    "section": { "$ref": "#/$defs/measuredNode" },
    "boards": {
      "type": "array",
      "minItems": 18,
      "maxItems": 18,
      "items": { "$ref": "#/$defs/board" }
    },
    "collections": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "created",
        "modesCreated",
        "localCollectionCount",
        "localVariableCount",
        "capturePath"
      ],
      "properties": {
        "created": {
          "type": "array",
          "minItems": 5,
          "maxItems": 5,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^VariableCollectionId:[0-9]+:[0-9]+$"
          }
        },
        "modesCreated": {
          "type": "array",
          "minItems": 6,
          "maxItems": 6,
          "uniqueItems": true,
          "items": { "type": "string", "pattern": "^[0-9]+:[0-9]+$" }
        },
        "localCollectionCount": { "const": 5 },
        "localVariableCount": { "const": 80 },
        "capturePath": {
          "const": "evidence/figma/ios-003-1-color-variables.capture.json"
        }
      }
    },
    "figmaRevision": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "value", "reason"],
      "properties": {
        "status": { "const": "unavailable" },
        "value": { "type": "null" },
        "reason": { "type": "string", "minLength": 1 }
      }
    },
    "screenshots": {
      "type": "array",
      "minItems": 9,
      "maxItems": 9,
      "items": { "$ref": "#/$defs/screenshot" }
    },
    "verification": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "pageReRead",
        "boardCount",
        "boardOrderAndNames",
        "componentCount",
        "unboundColorLiteralCount",
        "localStyleCount",
        "editableSwatchCount",
        "canonicalBoundSwatchCount",
        "emptyEditableSwatchCount",
        "semanticAliasCount",
        "themeAliasCount",
        "themeCompleteness",
        "fontFamilies",
        "publishAction",
        "libraryVisibilityVerification",
        "canonicalTokenDiff",
        "driftStatus"
      ],
      "properties": {
        "pageReRead": { "const": true },
        "boardCount": { "const": 18 },
        "boardOrderAndNames": { "const": true },
        "componentCount": { "const": 0 },
        "unboundColorLiteralCount": { "const": 0 },
        "localStyleCount": { "const": 0 },
        "editableSwatchCount": { "const": 110 },
        "canonicalBoundSwatchCount": { "const": 32 },
        "emptyEditableSwatchCount": { "const": 78 },
        "semanticAliasCount": { "const": 24 },
        "themeAliasCount": { "const": 48 },
        "themeCompleteness": { "const": "24/24 in Light and Dark" },
        "fontFamilies": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "const": "Inter" }
        },
        "publishAction": { "const": "not-invoked" },
        "libraryVisibilityVerification": {
          "const": "unavailable-from-integration"
        },
        "canonicalTokenDiff": { "const": "none" },
        "driftStatus": { "const": "synchronized" }
      }
    },
    "differences": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 },
      "uniqueItems": true
    },
    "approvals": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "overall",
        "design",
        "accessibility",
        "engineering",
        "independentRelease"
      ],
      "properties": {
        "overall": { "const": "pending-human-review" },
        "design": { "const": "pending" },
        "accessibility": { "const": "pending-specialist-review" },
        "engineering": { "const": "pending-specialist-review" },
        "independentRelease": { "const": "pending" }
      }
    }
  },
  "$defs": {
    "nodeId": { "type": "string", "pattern": "^[0-9]+:[0-9]+$" },
    "measuredNode": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "name", "width", "height"],
      "properties": {
        "id": { "$ref": "#/$defs/nodeId" },
        "name": { "type": "string", "minLength": 1 },
        "width": { "type": "number", "exclusiveMinimum": 0 },
        "height": { "type": "number", "exclusiveMinimum": 0 }
      }
    },
    "nestedNode": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "name"],
      "properties": {
        "id": { "$ref": "#/$defs/nodeId" },
        "name": { "type": "string", "minLength": 1 }
      }
    },
    "board": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "order",
        "id",
        "name",
        "width",
        "height",
        "y",
        "header",
        "documentation",
        "content"
      ],
      "properties": {
        "order": { "type": "integer", "minimum": 1, "maximum": 18 },
        "id": { "$ref": "#/$defs/nodeId" },
        "name": {
          "type": "string",
          "pattern": "^Color / (?:0[1-9]|1[0-8]) .+$"
        },
        "width": { "const": 1440 },
        "height": { "type": "number", "minimum": 900 },
        "y": { "type": "number", "minimum": 0 },
        "header": { "$ref": "#/$defs/nestedNode" },
        "documentation": { "$ref": "#/$defs/nestedNode" },
        "content": { "$ref": "#/$defs/nestedNode" }
      }
    },
    "screenshot": {
      "type": "object",
      "additionalProperties": false,
      "required": ["nodeId", "path", "sha256"],
      "properties": {
        "nodeId": { "$ref": "#/$defs/nodeId" },
        "path": { "type": "string", "pattern": "^evidence/screenshots/" },
        "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
      }
    }
  }
}
