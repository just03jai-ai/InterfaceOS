{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://interfaceos.dev/schemas/figma-color-variable-capture.schema.json",
  "title": "InterfaceOS Figma Color Variable Capture",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "id",
    "milestone",
    "status",
    "capturedAt",
    "fileKey",
    "pageNodeId",
    "sourceRevision",
    "collections",
    "primitiveVariables",
    "themeVariables",
    "semanticVariables",
    "verification",
    "approvals"
  ],
  "properties": {
    "schemaVersion": { "const": "1.0.0" },
    "id": { "const": "IOS-003.1-FIGMA-COLOR-VARIABLE-CAPTURE" },
    "milestone": { "const": "IOS-003.1" },
    "status": { "const": "captured-pending-human-review" },
    "capturedAt": { "type": "string", "format": "date-time" },
    "fileKey": { "const": "OJqxFKoGjRh4rrSZCKdkzi" },
    "pageNodeId": { "const": "2:4" },
    "sourceRevision": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
    "collections": {
      "type": "array",
      "minItems": 5,
      "maxItems": 5,
      "items": { "$ref": "#/$defs/collection" }
    },
    "primitiveVariables": {
      "type": "array",
      "minItems": 32,
      "maxItems": 32,
      "items": { "$ref": "#/$defs/primitiveVariable" }
    },
    "themeVariables": {
      "type": "array",
      "minItems": 24,
      "maxItems": 24,
      "items": { "$ref": "#/$defs/themeVariable" }
    },
    "semanticVariables": {
      "type": "array",
      "minItems": 24,
      "maxItems": 24,
      "items": { "$ref": "#/$defs/semanticVariable" }
    },
    "verification": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "collectionCount",
        "colorVariableCount",
        "duplicateNames",
        "primitiveBindings",
        "themeAliases",
        "semanticAliases",
        "responsiveColorVariables",
        "motionColorVariables",
        "hiddenFromPublishing",
        "driftStatus"
      ],
      "properties": {
        "collectionCount": { "const": 5 },
        "colorVariableCount": { "const": 80 },
        "duplicateNames": { "const": 0 },
        "primitiveBindings": { "const": "32/32" },
        "themeAliases": { "const": "48/48" },
        "semanticAliases": { "const": "24/24" },
        "responsiveColorVariables": { "const": 0 },
        "motionColorVariables": { "const": 0 },
        "hiddenFromPublishing": { "const": true },
        "driftStatus": { "const": "synchronized" }
      }
    },
    "approvals": {
      "type": "object",
      "additionalProperties": false,
      "required": ["design", "accessibility", "engineering", "release"],
      "properties": {
        "design": { "const": "pending-human-review" },
        "accessibility": { "const": "pending-specialist-review" },
        "engineering": { "const": "pending-specialist-review" },
        "release": { "const": "blocked" }
      }
    }
  },
  "$defs": {
    "collectionId": {
      "type": "string",
      "pattern": "^VariableCollectionId:[0-9]+:[0-9]+$"
    },
    "variableId": { "type": "string", "pattern": "^VariableID:[0-9]+:[0-9]+$" },
    "modeId": { "type": "string", "pattern": "^[0-9]+:[0-9]+$" },
    "collection": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "collectionId",
        "defaultModeId",
        "modes",
        "colorVariableCount",
        "hiddenFromPublishing"
      ],
      "properties": {
        "name": {
          "enum": ["Primitive", "Semantic", "Theme", "Responsive", "Motion"]
        },
        "collectionId": { "$ref": "#/$defs/collectionId" },
        "defaultModeId": { "$ref": "#/$defs/modeId" },
        "modes": {
          "type": "array",
          "minItems": 1,
          "maxItems": 2,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["name", "modeId"],
            "properties": {
              "name": { "enum": ["Mode 1", "Light", "Dark"] },
              "modeId": { "$ref": "#/$defs/modeId" }
            }
          }
        },
        "colorVariableCount": { "enum": [0, 24, 32] },
        "hiddenFromPublishing": { "const": true }
      }
    },
    "baseVariable": {
      "type": "object",
      "required": [
        "canonicalTokenPath",
        "figmaName",
        "variableId",
        "collectionId"
      ],
      "properties": {
        "canonicalTokenPath": {
          "type": "string",
          "pattern": "^color\\.(?:primitive|theme|semantic)\\.[a-z0-9.-]+$"
        },
        "figmaName": {
          "type": "string",
          "pattern": "^color/(?:primitive|theme|semantic)/[a-z0-9/-]+$"
        },
        "variableId": { "$ref": "#/$defs/variableId" },
        "collectionId": { "$ref": "#/$defs/collectionId" }
      }
    },
    "alias": {
      "type": "object",
      "additionalProperties": false,
      "required": ["canonicalTokenPath", "variableId"],
      "properties": {
        "canonicalTokenPath": {
          "type": "string",
          "pattern": "^color\\.(?:primitive|theme)\\.[a-z0-9.-]+$"
        },
        "variableId": { "$ref": "#/$defs/variableId" }
      }
    },
    "primitiveVariable": {
      "allOf": [
        { "$ref": "#/$defs/baseVariable" },
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "canonicalTokenPath": {
              "type": "string",
              "pattern": "^color\\.primitive\\.[a-z]+\\.[0-9]+$"
            },
            "figmaName": {
              "type": "string",
              "pattern": "^color/primitive/[a-z]+/[0-9]+$"
            },
            "variableId": { "$ref": "#/$defs/variableId" },
            "collectionId": { "$ref": "#/$defs/collectionId" }
          }
        }
      ]
    },
    "themeVariable": {
      "allOf": [
        { "$ref": "#/$defs/baseVariable" },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["lightAlias", "darkAlias"],
          "properties": {
            "canonicalTokenPath": {
              "type": "string",
              "pattern": "^color\\.theme\\.[a-z0-9.-]+$"
            },
            "figmaName": {
              "type": "string",
              "pattern": "^color/theme/[a-z0-9/-]+$"
            },
            "variableId": { "$ref": "#/$defs/variableId" },
            "collectionId": { "$ref": "#/$defs/collectionId" },
            "lightAlias": { "$ref": "#/$defs/alias" },
            "darkAlias": { "$ref": "#/$defs/alias" }
          }
        }
      ]
    },
    "semanticVariable": {
      "allOf": [
        { "$ref": "#/$defs/baseVariable" },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["themeAlias"],
          "properties": {
            "canonicalTokenPath": {
              "type": "string",
              "pattern": "^color\\.semantic\\.[a-z0-9.-]+$"
            },
            "figmaName": {
              "type": "string",
              "pattern": "^color/semantic/[a-z0-9/-]+$"
            },
            "variableId": { "$ref": "#/$defs/variableId" },
            "collectionId": { "$ref": "#/$defs/collectionId" },
            "themeAlias": { "$ref": "#/$defs/alias" }
          }
        }
      ]
    }
  }
}
