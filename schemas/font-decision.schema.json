{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://interfaceos.dev/schemas/font-decision.schema.json",
  "title": "InterfaceOS Font Decision Matrix",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "$schema",
    "schemaVersion",
    "id",
    "status",
    "selectedCandidate",
    "candidates",
    "humanDecisions",
    "approvals"
  ],
  "properties": {
    "$schema": { "type": "string", "format": "uri-reference" },
    "schemaVersion": { "const": "1.0.0" },
    "id": { "const": "IOS-004-FONT-DECISION" },
    "status": { "const": "pending-human-decision" },
    "selectedCandidate": { "type": "null" },
    "candidates": {
      "type": "array",
      "minItems": 5,
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/candidate" }
    },
    "humanDecisions": {
      "type": "array",
      "minItems": 10,
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 1 }
    },
    "approvals": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "design",
        "engineering",
        "accessibility",
        "licensing",
        "independentRelease"
      ],
      "properties": {
        "design": { "const": "pending" },
        "engineering": { "const": "pending-specialist-review" },
        "accessibility": { "const": "pending-specialist-review" },
        "licensing": { "const": "pending" },
        "independentRelease": { "const": "pending" }
      }
    }
  },
  "$defs": {
    "candidate": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "name",
        "category",
        "readability",
        "licensing",
        "webDelivery",
        "nativeCompatibility",
        "variableFont",
        "languageCoverage",
        "fileSize",
        "brandFit",
        "figmaAvailability",
        "source"
      ],
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" },
        "name": { "type": "string", "minLength": 1 },
        "category": { "type": "string", "minLength": 1 },
        "readability": { "type": "string", "minLength": 1 },
        "licensing": { "type": "string", "pattern": "pending|platform-terms" },
        "webDelivery": { "type": "string", "minLength": 1 },
        "nativeCompatibility": { "type": "string", "minLength": 1 },
        "variableFont": { "type": "string", "minLength": 1 },
        "languageCoverage": { "type": "string", "minLength": 1 },
        "fileSize": { "type": "string", "minLength": 1 },
        "brandFit": { "type": "string", "minLength": 1 },
        "figmaAvailability": { "type": "string", "minLength": 1 },
        "source": { "type": "string", "format": "uri" }
      }
    }
  }
}
