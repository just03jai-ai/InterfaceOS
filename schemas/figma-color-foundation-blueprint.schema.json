{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://interfaceos.dev/schemas/figma-color-foundation-blueprint.schema.json",
  "title": "InterfaceOS Figma Color Foundation Blueprint",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "$schema",
    "schemaVersion",
    "id",
    "milestone",
    "status",
    "file",
    "page",
    "section",
    "layout",
    "variablePlaceholders",
    "boards",
    "constraints",
    "reviews"
  ],
  "properties": {
    "$schema": { "type": "string", "format": "uri-reference" },
    "schemaVersion": { "const": "1.0.0" },
    "id": { "const": "IOS-FND-COLOR-FIGMA" },
    "milestone": { "const": "IOS-003.1" },
    "status": {
      "enum": [
        "blueprint-pending-implementation-approval",
        "implemented-pending-human-review"
      ]
    },
    "file": {
      "type": "object",
      "additionalProperties": false,
      "required": ["key", "name"],
      "properties": {
        "key": { "const": "OJqxFKoGjRh4rrSZCKdkzi" },
        "name": { "const": "InterfaceOS — Design System" }
      }
    },
    "page": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "id", "verificationStatus"],
      "properties": {
        "name": { "const": "03 Foundations" },
        "id": { "type": "string", "pattern": "^[0-9]+:[0-9]+$" },
        "verificationStatus": { "const": "verified" }
      }
    },
    "section": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "id", "captureStatus"],
      "properties": {
        "name": { "const": "Color" },
        "id": { "type": ["string", "null"] },
        "captureStatus": { "enum": ["pending-creation", "captured"] }
      }
    },
    "layout": { "type": "object" },
    "variablePlaceholders": {
      "type": "array",
      "minItems": 5,
      "maxItems": 5,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["collection", "responsibility", "collectionId"],
        "properties": {
          "collection": {
            "enum": ["Primitive", "Semantic", "Theme", "Responsive", "Motion"]
          },
          "responsibility": { "type": "string", "minLength": 1 },
          "collectionId": { "type": ["string", "null"] }
        }
      }
    },
    "boards": {
      "type": "array",
      "minItems": 18,
      "maxItems": 18,
      "items": { "$ref": "#/$defs/board" }
    },
    "constraints": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "createComponents",
        "createVariables",
        "createStyles",
        "createFinalColorValues",
        "publishLibrary",
        "componentColorDependency"
      ],
      "properties": {
        "createComponents": { "const": false },
        "createVariables": { "const": true },
        "createStyles": { "const": false },
        "createFinalColorValues": { "const": false },
        "publishLibrary": { "const": false },
        "componentColorDependency": { "const": "semantic-only" }
      }
    },
    "reviews": { "type": "object" }
  },
  "$defs": {
    "board": {
      "type": "object",
      "additionalProperties": false,
      "required": ["order", "name", "purpose", "content", "frameId", "status"],
      "properties": {
        "order": { "type": "integer", "minimum": 1, "maximum": 18 },
        "name": {
          "type": "string",
          "pattern": "^Color / (?:0[1-9]|1[0-8]) .+$"
        },
        "purpose": { "type": "string", "minLength": 1 },
        "content": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1 }
        },
        "frameId": { "type": ["string", "null"] },
        "status": { "enum": ["pending-creation", "created", "verified"] }
      }
    }
  }
}
