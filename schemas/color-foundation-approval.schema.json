{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://interfaceos.dev/schemas/color-foundation-approval.schema.json",
  "title": "InterfaceOS Color Foundation V1 Approval Record",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "$schema",
    "schemaVersion",
    "id",
    "milestone",
    "status",
    "approvedAt",
    "approver",
    "baseline",
    "reviews",
    "controls",
    "execution",
    "figmaEvidence",
    "remainingGates"
  ],
  "properties": {
    "$schema": { "type": "string", "format": "uri-reference" },
    "schemaVersion": { "const": "1.0.0" },
    "id": { "const": "IOS-003.1-COLOR-FOUNDATION-APPROVAL" },
    "milestone": { "const": "IOS-003.1" },
    "status": { "const": "approved-visual-baseline-pending-token-promotion" },
    "approvedAt": { "type": "string", "format": "date" },
    "approver": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "role"],
      "properties": {
        "name": { "const": "Jai Singh" },
        "role": { "const": "Interim Design System Owner" }
      }
    },
    "baseline": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "version",
        "primaryFamily",
        "coreFamilies",
        "extendedFamilies",
        "dataCategoryCount",
        "themes",
        "approvedSystems"
      ],
      "properties": {
        "version": { "const": "1.0.0" },
        "primaryFamily": { "const": "blue" },
        "coreFamilies": {
          "type": "array",
          "prefixItems": [
            { "const": "neutral" },
            { "const": "blue" },
            { "const": "green" },
            { "const": "amber" },
            { "const": "red" }
          ],
          "minItems": 5,
          "maxItems": 5
        },
        "extendedFamilies": {
          "type": "array",
          "prefixItems": [
            { "const": "indigo" },
            { "const": "purple" },
            { "const": "teal" }
          ],
          "minItems": 3,
          "maxItems": 3
        },
        "dataCategoryCount": { "const": 11 },
        "themes": {
          "type": "array",
          "prefixItems": [{ "const": "light" }, { "const": "dark" }],
          "minItems": 2,
          "maxItems": 2
        },
        "approvedSystems": {
          "type": "array",
          "minItems": 10,
          "uniqueItems": true,
          "items": {
            "enum": [
              "semantic-mapping",
              "interactive-states",
              "text-hierarchy",
              "surface-system",
              "border-system",
              "feedback-states",
              "dashboard-palette",
              "chart-testing",
              "light-theme",
              "dark-theme"
            ]
          }
        }
      }
    },
    "reviews": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "design",
        "accessibilityV1",
        "accessibilitySpecialistAudit",
        "engineering",
        "documentation",
        "governance",
        "independentRelease"
      ],
      "properties": {
        "design": { "const": "approved" },
        "accessibilityV1": { "const": "approved" },
        "accessibilitySpecialistAudit": { "const": "pending-non-blocking" },
        "engineering": { "const": "approved-by-milestone-owner" },
        "documentation": { "const": "approved" },
        "governance": { "const": "approved" },
        "independentRelease": { "const": "pending" }
      }
    },
    "controls": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "canonicalTokenValuesChanged",
        "figmaVariablesChanged",
        "componentsCreated",
        "libraryPublished",
        "libraryPublicationState",
        "fileSharingPermissions",
        "branchingState"
      ],
      "properties": {
        "canonicalTokenValuesChanged": { "const": false },
        "figmaVariablesChanged": { "const": false },
        "componentsCreated": { "const": false },
        "libraryPublished": { "const": false },
        "libraryPublicationState": { "const": "unpublished" },
        "fileSharingPermissions": {
          "const": "governed-separately-from-library-publication"
        },
        "branchingState": { "const": "enabled" }
      }
    },
    "execution": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "operator",
        "mechanism",
        "authenticated",
        "mutatedNodeIds",
        "variableCountBefore",
        "variableCountAfter",
        "componentCountAfter",
        "styleCountAfter",
        "allCollectionsHiddenFromPublishing"
      ],
      "properties": {
        "operator": { "const": "Codex" },
        "mechanism": {
          "const": "Authenticated Figma Plugin API integration"
        },
        "authenticated": { "const": true },
        "mutatedNodeIds": {
          "type": "array",
          "minItems": 22,
          "maxItems": 22,
          "uniqueItems": true,
          "items": { "type": "string", "pattern": "^[0-9]+:[0-9]+$" }
        },
        "variableCountBefore": { "const": 80 },
        "variableCountAfter": { "const": 80 },
        "componentCountAfter": { "const": 0 },
        "styleCountAfter": { "const": 0 },
        "allCollectionsHiddenFromPublishing": { "const": true }
      }
    },
    "figmaEvidence": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "fileKey",
        "pageNodeId",
        "sectionNodeId",
        "decisionLogNodeId",
        "reviewBoardNodeId",
        "screenshots",
        "figmaRevision"
      ],
      "properties": {
        "fileKey": { "const": "OJqxFKoGjRh4rrSZCKdkzi" },
        "pageNodeId": { "const": "2:4" },
        "sectionNodeId": { "const": "26:14" },
        "decisionLogNodeId": { "const": "27:21" },
        "reviewBoardNodeId": { "const": "27:22" },
        "screenshots": {
          "type": "array",
          "minItems": 2,
          "maxItems": 2,
          "uniqueItems": true,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["nodeId", "path", "sha256"],
            "properties": {
              "nodeId": { "enum": ["27:21", "27:22"] },
              "path": {
                "type": "string",
                "pattern": "^evidence/screenshots/ios-003-1/"
              },
              "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
            }
          }
        },
        "figmaRevision": {
          "type": "object",
          "additionalProperties": false,
          "required": ["status", "value", "note"],
          "properties": {
            "status": {
              "const": "pending-named-version-before-public-release"
            },
            "value": { "type": "null" },
            "note": { "type": "string", "minLength": 1 }
          }
        }
      }
    },
    "remainingGates": {
      "type": "array",
      "minItems": 4,
      "uniqueItems": true,
      "items": {
        "enum": [
          "canonical-token-promotion",
          "accessibility-specialist-audit",
          "named-figma-version",
          "independent-public-release-approval"
        ]
      }
    }
  }
}
