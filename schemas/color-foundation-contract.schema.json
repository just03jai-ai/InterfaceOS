{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://interfaceos.dev/schemas/color-foundation-contract.schema.json",
  "title": "InterfaceOS Color Foundation Specification Contract",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "$schema",
    "schemaVersion",
    "id",
    "milestone",
    "status",
    "owner",
    "canonicalSources",
    "currentBaseline",
    "primitiveArchitecture",
    "semanticArchitecture",
    "themeArchitecture",
    "validationRequirements",
    "approvalState"
  ],
  "properties": {
    "$schema": { "type": "string", "format": "uri-reference" },
    "schemaVersion": { "const": "1.0.0" },
    "id": { "const": "IOS-FND-COLOR" },
    "milestone": { "const": "IOS-003.2" },
    "status": {
      "const": "canonical-token-promotion-implemented-pending-review"
    },
    "owner": { "const": "Jai Singh" },
    "canonicalSources": {
      "type": "array",
      "minItems": 4,
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/repoPath" }
    },
    "currentBaseline": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "primitiveCount",
        "semanticCount",
        "themes",
        "classification"
      ],
      "properties": {
        "primitiveCount": { "const": 100 },
        "semanticCount": { "const": 35 },
        "themes": {
          "type": "array",
          "prefixItems": [{ "const": "light" }, { "const": "dark" }],
          "minItems": 2,
          "maxItems": 2
        },
        "classification": {
          "const": "canonical-color-foundation-v1-promoted-private"
        }
      }
    },
    "primitiveArchitecture": {
      "type": "object",
      "additionalProperties": false,
      "required": ["namingPattern", "recommendedStops", "families"],
      "properties": {
        "namingPattern": {
          "const": "color.primitive.{family}.{step}"
        },
        "recommendedStops": {
          "type": "array",
          "prefixItems": [
            { "const": "50" },
            { "const": "100" },
            { "const": "200" },
            { "const": "300" },
            { "const": "400" },
            { "const": "500" },
            { "const": "600" },
            { "const": "700" },
            { "const": "800" },
            { "const": "900" },
            { "const": "950" }
          ],
          "minItems": 11,
          "maxItems": 11
        },
        "families": {
          "type": "array",
          "minItems": 11,
          "maxItems": 11,
          "items": { "$ref": "#/$defs/primitiveFamily" }
        }
      }
    },
    "semanticArchitecture": {
      "type": "object",
      "additionalProperties": false,
      "required": ["namingPattern", "categories"],
      "properties": {
        "namingPattern": {
          "const": "color.semantic.{purpose}.{role}.{state?}"
        },
        "categories": {
          "type": "array",
          "minItems": 19,
          "maxItems": 19,
          "items": { "$ref": "#/$defs/semanticCategory" }
        }
      }
    },
    "themeArchitecture": {
      "type": "object",
      "additionalProperties": false,
      "required": ["current", "future", "mappingRule"],
      "properties": {
        "current": {
          "type": "array",
          "prefixItems": [{ "const": "light" }, { "const": "dark" }],
          "minItems": 2,
          "maxItems": 2
        },
        "future": {
          "type": "array",
          "prefixItems": [
            { "const": "brand-themes" },
            { "const": "high-contrast" }
          ],
          "minItems": 2,
          "maxItems": 2
        },
        "mappingRule": {
          "const": "semantic-to-theme-to-primitive"
        }
      }
    },
    "validationRequirements": {
      "type": "array",
      "minItems": 5,
      "uniqueItems": true,
      "items": {
        "enum": [
          "missing-semantic-mappings",
          "duplicate-primitive-values",
          "missing-dark-values",
          "contrast-obligations",
          "naming-violations",
          "full-stop-completeness",
          "anchor-preservation",
          "data-namespace-completeness",
          "candidate-provenance",
          "deterministic-generation",
          "figma-token-drift"
        ]
      }
    },
    "approvalState": {
      "type": "object",
      "additionalProperties": false,
      "required": ["visual", "engineering", "accessibility", "release"],
      "properties": {
        "visual": { "const": "approved" },
        "engineering": { "const": "approved-by-milestone-owner" },
        "accessibility": {
          "const": "approved-v1-specialist-audit-pending-non-blocking"
        },
        "release": { "const": "blocked-pending-independent-approval" }
      }
    }
  },
  "$defs": {
    "repoPath": {
      "type": "string",
      "pattern": "^(?!/)(?!.*\\.\\.)[^\\s]+$"
    },
    "primitiveFamily": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "disposition", "usageIntent"],
      "properties": {
        "name": {
          "enum": [
            "neutral",
            "blue",
            "green",
            "red",
            "amber",
            "orange",
            "yellow",
            "indigo",
            "purple",
            "teal",
            "pink"
          ]
        },
        "disposition": {
          "enum": [
            "approved-core-v1",
            "approved-extended-v1",
            "not-selected-v1"
          ]
        },
        "usageIntent": { "type": "string", "minLength": 1 }
      }
    },
    "semanticCategory": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "coverage", "intent"],
      "properties": {
        "name": {
          "enum": [
            "primary",
            "secondary",
            "accent",
            "success",
            "warning",
            "error",
            "info",
            "surface",
            "background",
            "border",
            "text",
            "interactive",
            "focus",
            "selection",
            "overlay",
            "disabled",
            "inverse",
            "muted",
            "data"
          ]
        },
        "coverage": {
          "enum": ["current", "partial-current", "gap", "decision-required"]
        },
        "intent": { "type": "string", "minLength": 1 }
      }
    }
  }
}
