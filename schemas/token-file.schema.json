{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://interfaceos.dev/schemas/token-file.schema.json",
  "title": "InterfaceOS DTCG-compatible Token File",
  "$ref": "#/$defs/group",
  "$defs": {
    "node": {
      "oneOf": [{ "$ref": "#/$defs/token" }, { "$ref": "#/$defs/group" }]
    },
    "group": {
      "type": "object",
      "minProperties": 1,
      "propertyNames": {
        "pattern": "^(?:\\$[a-z][a-zA-Z0-9-]*|[a-z0-9][a-z0-9-]*)$"
      },
      "properties": {
        "$schema": { "type": "string", "format": "uri-reference" },
        "$description": { "type": "string", "minLength": 1 },
        "$type": { "$ref": "#/$defs/tokenType" },
        "$extensions": { "type": "object" }
      },
      "patternProperties": {
        "^(?!\\$)[a-z0-9][a-z0-9-]*$": { "$ref": "#/$defs/node" }
      },
      "additionalProperties": false
    },
    "token": {
      "type": "object",
      "additionalProperties": false,
      "required": ["$value", "$type", "$description", "$extensions"],
      "properties": {
        "$value": {},
        "$type": { "$ref": "#/$defs/tokenType" },
        "$description": { "type": "string", "minLength": 1 },
        "$deprecated": {
          "anyOf": [{ "type": "boolean" }, { "type": "string" }]
        },
        "$extensions": {
          "type": "object",
          "additionalProperties": true,
          "required": ["org.interfaceos"],
          "properties": {
            "org.interfaceos": {
              "type": "object",
              "additionalProperties": false,
              "required": ["tier", "status"],
              "properties": {
                "tier": {
                  "enum": [
                    "primitive",
                    "semantic",
                    "theme",
                    "component",
                    "responsive"
                  ]
                },
                "status": { "enum": ["draft", "approved", "deprecated"] }
              }
            }
          }
        }
      },
      "allOf": [
        {
          "if": { "properties": { "$type": { "const": "color" } } },
          "then": {
            "properties": {
              "$value": {
                "oneOf": [
                  { "$ref": "#/$defs/alias" },
                  { "$ref": "#/$defs/colorValue" }
                ]
              }
            }
          }
        },
        {
          "if": { "properties": { "$type": { "const": "dimension" } } },
          "then": {
            "properties": {
              "$value": {
                "oneOf": [
                  { "$ref": "#/$defs/alias" },
                  { "$ref": "#/$defs/dimensionValue" }
                ]
              }
            }
          }
        },
        {
          "if": { "properties": { "$type": { "const": "duration" } } },
          "then": {
            "properties": {
              "$value": {
                "oneOf": [
                  { "$ref": "#/$defs/alias" },
                  { "$ref": "#/$defs/durationValue" }
                ]
              }
            }
          }
        },
        {
          "if": { "properties": { "$type": { "const": "fontFamily" } } },
          "then": {
            "properties": {
              "$value": {
                "oneOf": [
                  { "$ref": "#/$defs/alias" },
                  {
                    "type": "array",
                    "minItems": 1,
                    "items": { "type": "string", "minLength": 1 }
                  }
                ]
              }
            }
          }
        },
        {
          "if": { "properties": { "$type": { "const": "fontWeight" } } },
          "then": {
            "properties": {
              "$value": {
                "oneOf": [
                  { "$ref": "#/$defs/alias" },
                  { "type": "number", "minimum": 1, "maximum": 1000 }
                ]
              }
            }
          }
        },
        {
          "if": { "properties": { "$type": { "const": "number" } } },
          "then": {
            "properties": {
              "$value": {
                "oneOf": [{ "$ref": "#/$defs/alias" }, { "type": "number" }]
              }
            }
          }
        },
        {
          "if": { "properties": { "$type": { "const": "cubicBezier" } } },
          "then": {
            "properties": {
              "$value": {
                "oneOf": [
                  { "$ref": "#/$defs/alias" },
                  { "$ref": "#/$defs/cubicBezierValue" }
                ]
              }
            }
          }
        },
        {
          "if": { "properties": { "$type": { "const": "strokeStyle" } } },
          "then": {
            "properties": {
              "$value": {
                "oneOf": [
                  { "$ref": "#/$defs/alias" },
                  { "enum": ["solid", "dashed", "dotted", "double", "none"] }
                ]
              }
            }
          }
        },
        {
          "if": { "properties": { "$type": { "const": "shadow" } } },
          "then": {
            "properties": {
              "$value": {
                "oneOf": [
                  { "$ref": "#/$defs/alias" },
                  {
                    "type": "array",
                    "items": { "$ref": "#/$defs/shadowLayer" }
                  }
                ]
              }
            }
          }
        },
        {
          "if": { "properties": { "$type": { "const": "typography" } } },
          "then": {
            "properties": {
              "$value": {
                "oneOf": [{ "$ref": "#/$defs/alias" }, { "type": "object" }]
              }
            }
          }
        }
      ]
    },
    "alias": { "type": "string", "pattern": "^\\{[a-z0-9][a-z0-9.-]*\\}$" },
    "colorValue": {
      "type": "object",
      "additionalProperties": false,
      "required": ["colorSpace", "components", "alpha"],
      "properties": {
        "colorSpace": {
          "enum": [
            "srgb",
            "srgb-linear",
            "display-p3",
            "a98-rgb",
            "prophoto-rgb",
            "rec2020",
            "xyz-d65",
            "xyz-d50",
            "lab",
            "lch",
            "oklab",
            "oklch",
            "hsl",
            "hwb"
          ]
        },
        "components": {
          "type": "array",
          "minItems": 3,
          "maxItems": 3,
          "items": { "type": "number" }
        },
        "alpha": { "type": "number", "minimum": 0, "maximum": 1 },
        "hex": { "type": "string", "pattern": "^#[0-9a-fA-F]{6}$" }
      }
    },
    "dimensionValue": {
      "type": "object",
      "additionalProperties": false,
      "required": ["value", "unit"],
      "properties": {
        "value": { "type": "number" },
        "unit": { "enum": ["px", "rem"] }
      }
    },
    "durationValue": {
      "type": "object",
      "additionalProperties": false,
      "required": ["value", "unit"],
      "properties": {
        "value": { "type": "number", "minimum": 0 },
        "unit": { "enum": ["ms", "s"] }
      }
    },
    "cubicBezierValue": {
      "type": "array",
      "minItems": 4,
      "maxItems": 4,
      "prefixItems": [
        { "type": "number", "minimum": 0, "maximum": 1 },
        { "type": "number" },
        { "type": "number", "minimum": 0, "maximum": 1 },
        { "type": "number" }
      ]
    },
    "shadowLayer": {
      "type": "object",
      "additionalProperties": false,
      "required": ["color", "offsetX", "offsetY", "blur", "spread"],
      "properties": {
        "color": { "$ref": "#/$defs/colorValue" },
        "offsetX": { "$ref": "#/$defs/dimensionValue" },
        "offsetY": { "$ref": "#/$defs/dimensionValue" },
        "blur": { "$ref": "#/$defs/dimensionValue" },
        "spread": { "$ref": "#/$defs/dimensionValue" }
      }
    },
    "tokenType": {
      "enum": [
        "color",
        "dimension",
        "fontFamily",
        "fontWeight",
        "number",
        "duration",
        "cubicBezier",
        "strokeStyle",
        "shadow",
        "typography"
      ]
    }
  }
}
