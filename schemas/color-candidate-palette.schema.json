{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://interfaceos.dev/schemas/color-candidate-palette.schema.json",
  "title": "InterfaceOS provisional color candidate palette",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "$schema",
    "schemaVersion",
    "id",
    "milestone",
    "status",
    "generatedAt",
    "source",
    "method",
    "families",
    "dataColors",
    "dataAssessment",
    "approvals"
  ],
  "properties": {
    "$schema": { "type": "string", "format": "uri-reference" },
    "schemaVersion": { "const": "1.0.0" },
    "id": { "const": "IOS-FND-COLOR-CANDIDATE-PALETTE" },
    "milestone": { "const": "IOS-003.1" },
    "status": { "const": "provisional-not-canonical" },
    "generatedAt": { "type": "string", "format": "date-time" },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "canonicalPath",
        "canonicalSha256",
        "gitCommit",
        "canonicalValuesModified"
      ],
      "properties": {
        "canonicalPath": {
          "const": "packages/tokens/src/primitives/color.tokens.json"
        },
        "canonicalSha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
        "gitCommit": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
        "canonicalValuesModified": { "const": false }
      }
    },
    "method": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "colorSpace",
        "interpolation",
        "endpointStrategy",
        "gamutStrategy",
        "newFamilyStrategy",
        "externalPaletteValuesUsed"
      ],
      "properties": {
        "colorSpace": { "const": "OKLCH" },
        "interpolation": { "type": "string", "minLength": 1 },
        "endpointStrategy": { "type": "string", "minLength": 1 },
        "gamutStrategy": { "type": "string", "minLength": 1 },
        "newFamilyStrategy": { "type": "string", "minLength": 1 },
        "externalPaletteValuesUsed": { "const": false }
      }
    },
    "families": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "neutral",
        "blue",
        "green",
        "red",
        "amber",
        "indigo",
        "purple",
        "teal",
        "primary"
      ],
      "properties": {
        "neutral": {
          "type": "array",
          "minItems": 12,
          "maxItems": 12,
          "items": { "$ref": "#/$defs/swatch" }
        },
        "blue": { "$ref": "#/$defs/standardFamily" },
        "green": { "$ref": "#/$defs/standardFamily" },
        "red": { "$ref": "#/$defs/standardFamily" },
        "amber": { "$ref": "#/$defs/standardFamily" },
        "indigo": { "$ref": "#/$defs/standardFamily" },
        "purple": { "$ref": "#/$defs/standardFamily" },
        "teal": { "$ref": "#/$defs/standardFamily" },
        "primary": { "$ref": "#/$defs/standardFamily" }
      }
    },
    "dataColors": {
      "type": "array",
      "minItems": 11,
      "maxItems": 11,
      "items": { "$ref": "#/$defs/dataSwatch" }
    },
    "dataAssessment": {
      "type": "object",
      "required": ["method", "pairs"],
      "properties": {
        "method": { "type": "string", "minLength": 1 },
        "pairs": { "type": "array", "minItems": 10, "maxItems": 10 }
      }
    },
    "approvals": {
      "type": "object",
      "additionalProperties": false,
      "required": ["design", "accessibility", "engineering", "release"],
      "properties": {
        "design": { "const": "pending-human-review" },
        "accessibility": { "const": "pending-specialist-review" },
        "engineering": { "const": "pending-specialist-review" },
        "release": { "const": "not-approved" }
      }
    }
  },
  "$defs": {
    "standardFamily": {
      "type": "array",
      "minItems": 11,
      "maxItems": 11,
      "items": { "$ref": "#/$defs/swatch" }
    },
    "oklch": {
      "type": "object",
      "required": ["L", "C", "h"],
      "properties": {
        "L": { "type": "number", "minimum": 0, "maximum": 1 },
        "C": { "type": "number", "minimum": 0 },
        "h": { "type": "number", "minimum": 0, "exclusiveMaximum": 360 }
      }
    },
    "swatch": {
      "type": "object",
      "required": [
        "family",
        "stop",
        "hex",
        "rgb",
        "oklch",
        "source",
        "canonicalStatus",
        "reviewStatus",
        "approval",
        "evidenceId",
        "sourcePath",
        "gamutAdjusted",
        "chromaReduction",
        "diagnostics",
        "contrast",
        "likelyUse"
      ],
      "properties": {
        "family": { "type": "string", "minLength": 1 },
        "stop": {
          "type": "string",
          "pattern": "^(?:0|0[1-9]|1[01]|50|100|200|300|400|500|600|700|800|900|950)$"
        },
        "hex": { "type": "string", "pattern": "^#[0-9A-F]{6}$" },
        "rgb": {
          "type": "array",
          "minItems": 3,
          "maxItems": 3,
          "items": { "type": "integer", "minimum": 0, "maximum": 255 }
        },
        "oklch": { "$ref": "#/$defs/oklch" },
        "requestedOklch": { "$ref": "#/$defs/oklch" },
        "source": { "type": "string", "minLength": 1 },
        "canonicalStatus": { "type": "string", "minLength": 1 },
        "reviewStatus": { "type": "string", "minLength": 1 },
        "approval": { "const": "Pending human review" },
        "evidenceId": { "type": "string", "pattern": "^IOS-FND-COLOR" },
        "sourcePath": { "type": "string", "minLength": 1 },
        "aliasCandidate": { "type": ["string", "null"] },
        "gamutAdjusted": { "type": "boolean" },
        "chromaReduction": { "type": "number", "minimum": 0 },
        "diagnostics": { "type": "object" },
        "contrast": { "type": "object" },
        "likelyUse": { "type": "string", "minLength": 1 }
      }
    },
    "dataSwatch": {
      "allOf": [
        { "$ref": "#/$defs/swatch" },
        {
          "type": "object",
          "required": ["hueRegion"],
          "properties": {
            "stop": { "type": "string", "pattern": "^(?:0[1-9]|1[01])$" },
            "hueRegion": { "type": "string", "minLength": 1 }
          }
        }
      ]
    }
  }
}
